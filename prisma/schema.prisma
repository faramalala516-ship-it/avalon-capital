generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PurchaseStatus {
  AWAITING_TRANSFER
  CONFIRMED
  CANCELED
}

model Collector {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String
  subscriptionActive  Boolean      @default(false)
  badges              String[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  purchases           Purchase[]
  bids                AuctionBid[]
}

model PhotoListing {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  mineral       String
  locality      String
  description   String
  technicalNote String
  priceEur      Int
  imageUrl      String
  monthKey      String
  featured      Boolean  @default(false)
  formats       String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchases     Purchase[]
}

model Purchase {
  id            String         @id @default(cuid())
  collectorId   String
  photoId       String
  formatId      String
  amountEur     Int
  reference     String
  status        PurchaseStatus @default(AWAITING_TRANSFER)
  certificateId String?
  txHash        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  collector     Collector      @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  photo         PhotoListing   @relation(fields: [photoId], references: [id], onDelete: Cascade)
}

model AuctionLot {
  id           String       @id @default(cuid())
  title        String
  mineral      String
  imageUrl     String
  startingBid  Int
  currentBid   Int
  endsAt       DateTime
  premiere     Boolean      @default(true)
  bids         AuctionBid[]
}

model AuctionBid {
  id          String     @id @default(cuid())
  lotId       String
  collectorId String
  amountEur   Int
  createdAt   DateTime   @default(now())
  lot         AuctionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  collector   Collector  @relation(fields: [collectorId], references: [id], onDelete: Cascade)
}

model Certificate {
  id            String   @id @default(cuid())
  certificateId String   @unique
  photoId       String
  photoTitle    String
  ownerEmail    String
  formatId      String
  amountEur     Int
  txHash        String
  previousHash  String
  issuedAt      DateTime @default(now())
}
