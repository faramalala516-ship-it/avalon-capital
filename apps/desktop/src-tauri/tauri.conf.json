{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avalon Agentique Platform",
  "version": "0.1.0",
  "identifier": "com.avaloncapital.agentique",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Avalon Command Center",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8741; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Avalon Capital",
    "shortDescription": "Local OS for Avalon AI agents",
    "longDescription": "Avalon Agentique Platform-Core — secure local agent runtime."
  },
  "plugins": {}
}
