<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX fragment reference for Avalon Agentique Platform.
  Primary MSI generation is via `tauri build` (bundle.targets includes msi).
  This file documents intended install layout for manual WiX pipelines.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Avalon Agentique Platform"
    Manufacturer="Avalon Capital"
    Version="0.1.0"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <Feature Id="Main" Title="Avalon" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AvalonVendorDir" Name="Avalon Capital">
        <Directory Id="INSTALLFOLDER" Name="Avalon Agentique Platform" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Components populated by candle/light or Tauri-generated WiX -->
    </ComponentGroup>
  </Fragment>
</Wix>
